# Local/private config goes in the include
[include]
        path = ~/.gitconfig.local
[column]
        ui = auto
[branch]
        sort = -committerdate
[tag]
        sort = version:refname
[color]
        diff = auto
        status = auto
        branch = auto
        ui = true
[diff]
        algorithm = histogram
        colorMoved = plain
        mnemonicPrefix = true
        renames = true
[fetch]
        prune = true
        pruneTags = true
        all = true
[core]
        excludesfile = ~/.gitignore
        editor = vim
[apply]
        whitespace = nowarn
[mergetool]
        keepBackup = false
[difftool]
        prompt = false
[help]
        autocorrect = prompt
[push]
        # See `git help config` (search for push.default)
        # for more information on different options of the below setting.
        #
        # Setting to git 2.0 default to suppress warning message
        default = simple
        autoSetupRemote = true
        followTags = true
[rebase]
        autoSquash = true
        autoStash = true
        updateRefs = true
[rerere]
        enabled = true
        autoupdate = true
[credential]
	helper = osxkeychain
[pull]
        ff = only

[init]
	defaultBranch = main
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[alias]
	# git <type> [-s|--scope <scope>] <message> commits with a conventional commit message
	conventional = "!a() { type=\"$1\"; shift; if [ \"$1\" = \"-s\" ] || [ \"$1\" = \"--scope\" ]; then type=\"$type($2)\"; shift 2; fi; git commit -m \"$type: $*\"; }; a"
	build = conventional build
	chore = conventional chore
	ci = conventional ci
	docs = conventional docs
	feat = conventional feat
	fix = conventional fix
	perf = conventional perf
	refactor = conventional refactor
	rev = conventional revert
	style = conventional style
	test = conventional test
	wip = conventional wip
